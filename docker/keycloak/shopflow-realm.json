{
  "realm": "shopflow",
  "displayName": "ShopFlow",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "ShopFlow customer role",
        "composite": false
      },
      {
        "name": "admin",
        "description": "ShopFlow admin role",
        "composite": false
      }
    ]
  },
  "groups": [],
  "clients": [
    {
      "clientId": "shopflow-gateway",
      "name": "ShopFlow Gateway",
      "description": "Public browser client (PKCE); direct access grants enabled for the classroom password-grant demos (icerik/08 §8.1)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*##http://localhost:3000/*"
      },
      "redirectUris": [
        "http://localhost:8080/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "+"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access"
      ]
    },
    {
      "clientId": "shopflow-backend",
      "name": "ShopFlow Backend",
      "description": "Confidential client for service-to-service (client credentials) demos",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "secret": "shopflow-backend-secret",
      "attributes": {
        "client_credentials.use_refresh_token": "false"
      },
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@shopflow.local",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Customer",
      "credentials": [
        {
          "type": "password",
          "value": "customer123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "customer"
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@shopflow.local",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    }
  ]
}
